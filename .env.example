# Copy to .env.local and adjust.

# Backend API base URL, e.g. the test server: https://edu.thesofmebel.uz/crm/api/v1
# Absolute URL: in dev the app calls its path (/crm/api/v1/…) on the dev server and Vite
# forwards it to the host (no CORS needed); a production build calls the URL directly.
# Relative (/api/v1): same origin; in dev Vite proxies /api to API_PROXY_TARGET.
# Vercel: set VITE_API_URL=/crm/api/v1 in Project Settings → Environment Variables;
# vercel.json forwards /crm/api/v1/… to the backend (it sends no CORS headers).
VITE_API_URL=https://edu.thesofmebel.uz/crm/api/v1

# Dev server only, used with a relative VITE_API_URL: where Vite forwards /api requests.
# API_PROXY_TARGET=http://localhost:8000
